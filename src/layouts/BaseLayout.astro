---
const { title = "Lab Website" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <style>
      :root {
        --max: 980px;
        --border: #eee;
        --muted: #666;
      }

      body {
        font-family: system-ui, Arial;
        margin: 0;
        background: #fff;
        color: #111;
      }

      header {
        position: sticky;
        top: 0;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
        z-index: 100;
      }

      .wrap {
        max-width: var(--max);
        margin: 0 auto;
        padding: 18px 20px;
      }

      nav a {
        margin-right: 14px;
        text-decoration: none;
        color: #111;
      }

      nav a:hover {
        text-decoration: underline;
      }

      .muted {
        color: var(--muted);
      }

      .card {
        padding: 16px;
        border: 1px solid var(--border);
        border-radius: 14px;
        margin: 12px 0;
      }

      h1 {
        margin: 10px 0 18px;
      }

      h2 {
        margin-top: 26px;
      }

      footer {
        border-top: 1px solid var(--border);
        margin-top: 40px;
      }

      ul {
        margin: 8px 0 0;
        padding-left: 18px;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 14px;
      }

      .btn {
        display: inline-block;
        padding: 10px 12px;
        border: 1px solid var(--border);
        border-radius: 12px;
        text-decoration: none;
        color: #111;
      }
    </style>
  </head>

  <body>
    <header>
      <div class="wrap">
        <div
          style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;"
        >
          <strong>Lab Website</strong>

          <nav>
            <a href={base}>Home</a>
            <a href={`${base}people/`}>People</a>
            <a href={`${base}research/`}>Research</a>
            <a href={`${base}publications/`}>Publications</a>
            <a href={`${base}news/`}>News</a>
            <a href={`${base}contact/`}>Contact</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer>
      <div class="wrap muted" style="font-size:14px;">
        © {new Date().getFullYear()} Lab Website • Built with Astro
      </div>
    </footer>
  </body>
</html>