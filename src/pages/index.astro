---
import BaseLayout from "../layouts/BaseLayout.astro";
import people from "../data/people.json";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const url = (path = "") => `${base}/${path.replace(/^\//, "")}`;
---

<BaseLayout title={people.labName}>
  <h1>{people.labName}</h1>

  <p class="muted" style="line-height:1.6">
    Welcome to our lab website. We share our research, publications, and daily updates here.
  </p>

  <div class="grid" style="margin-top:16px;">
    <a class="btn" href={url("people/")}>👩‍🔬 People</a>
    <a class="btn" href={url("research/")}>🔬 Research</a>
    <a class="btn" href={url("publications/")}>📄 Publications</a>
    <a class="btn" href={url("news/")}>🗞️ News</a>
    <a class="btn" href={url("contact/")}>✉️ Contact</a>
  </div>

  <h2 style="margin-top:28px;">Principal Investigator</h2>

  <div class="card">
    <strong>{people.pi.name}</strong>
    <div class="muted">
      {people.pi.title} • {people.pi.email}
    </div>
  </div>
</BaseLayout>